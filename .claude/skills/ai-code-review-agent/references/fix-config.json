{
  "version": "1.0.0",
  "description": "自动修复配置",

  "auto_fix_enabled": true,

  "fixable_severities": ["critical", "warning"],

  "max_review_rounds": 3,

  "max_fixes_per_run": 50,

  "rollback_enabled": true,

  "fix_modes": {
    "interactive": {
      "description": "交互模式，修复前需用户确认",
      "confirmation_required": true,
      "batch_size": 1
    },
    "semi_auto": {
      "description": "半自动模式，批量确认",
      "confirmation_required": true,
      "batch_size": 10
    },
    "full_auto": {
      "description": "全自动模式，自动执行所有可修复项",
      "confirmation_required": false,
      "risk_threshold": "low"
    }
  },

  "risk_policies": {
    "low": {
      "auto_approve": true,
      "description": "低风险修复可自动执行，如日志脱敏、空catch块补充"
    },
    "medium": {
      "auto_approve": false,
      "description": "中风险修复需确认，如命名规范修改"
    },
    "high": {
      "auto_approve": false,
      "description": "高风险修复需人工处理"
    }
  },

  "round_failure_actions": {
    "exhausted_rounds": {
      "action": "terminate",
      "message": "已达到最大审查轮次({max_rounds})，剩余问题需人工处理",
      "tag": "AI-FIX-FAILED",
      "comment_template": "## 自动修复终止\n\n已执行 {rounds} 轮审查修复，剩余 {remaining} 个问题无法自动修复：\n\n{remaining_issues}\n\n请人工处理后重新提交审查。"
    },
    "no_fixable_issues": {
      "action": "terminate",
      "message": "无可自动修复的问题，需人工处理",
      "tag": "AI-MANUAL-REQUIRED"
    }
  },

  "file_backup": {
    "enabled": true,
    "backup_dir": "DOCS/{work_item_id}/代码审查/backup",
    "keep_original": true
  }
}
