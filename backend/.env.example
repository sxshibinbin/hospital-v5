# ===== 必填配置 =====
# SECRET_KEY: JWT 签名密钥，生成方式: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# ENCRYPTION_KEY: AES 加密密钥（用于患者敏感数据），生成方式:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# DASHSCOPE_API_KEY: 阿里云 DashScope API 密钥
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxx

# POSTGRES_PASSWORD: PostgreSQL 数据库密码
POSTGRES_PASSWORD=CHANGE_ME

# ===== 数据库配置 =====
# 使用 docker-compose 时，主机名填 postgres
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@postgres:5432/hospital
# IoT 模块使用 psycopg，同库时保持和 DATABASE_URL 指向一致，去掉 +asyncpg 驱动后缀
IOT_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres:5432/hospital
POSTGRES_DB=hospital
POSTGRES_USER=postgres

# ===== Redis 配置 =====
# 使用 docker-compose 时，主机名填 redis
REDIS_URL=redis://localhost:6379/0

# ===== IoT 性能优化配置 =====
# IoT 数据库连接池最小连接数。开发环境建议 1，避免空闲连接长期占用数据库资源。
IOT_DB_POOL_MIN_SIZE=1
# IoT 数据库连接池最大连接数。当前上报规模建议 10，后续按实际写入并发和 PostgreSQL max_connections 调整。
IOT_DB_POOL_MAX_SIZE=10
# 文件监听单批最多处理的事件条数。值越大事务提交次数越少，但单批失败时重试范围也越大。
IOT_FILE_BATCH_SIZE=200
# 文件监听单轮最多处理时长，单位秒。超过后保存 checkpoint，下轮继续，避免大文件长时间独占处理循环。
IOT_FILE_BATCH_SECONDS=20
# 已绑定设备基础信息的内存缓存时间，单位秒。用于减少每条上报都查询设备和联系人信息。
IOT_DEVICE_CACHE_TTL_SECONDS=3600
# 未绑定或未知设备的负缓存时间，单位秒。用于减少非法/未绑定设备持续上报时的数据库查询压力。
IOT_DEVICE_NEGATIVE_CACHE_TTL_SECONDS=300
# 是否启用上报入口的绑定设备过滤。true 表示只接收已绑定设备，未绑定设备返回 success 但不写文件、不入库。
IOT_BOUND_FILTER_ENABLED=true
# Token used to verify IoT platform subscribe callbacks. Keep it identical to the platform setting.
IOT_SUBSCRIBE_TOKEN=

# ===== CORS 配置 =====
# 生产环境填写前端域名（多个用逗号分隔）
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# ===== 可选配置 =====
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=json
SQL_ECHO=false

# ===== 短信验证码调试模式 =====
# true 时：随机验证码与硬编码 123456 同时有效，接口返回 debug_mode/debug_code
# 生产环境务必设为 false 或删除此行
SMS_DEBUG_MODE=false

# ===== 阿里云短信验证码配置 =====
# AccessKey 默认复用 ALIBABA_CLOUD_ACCESS_KEY_ID / ALIBABA_CLOUD_ACCESS_KEY_SECRET；
# 如需短信单独授权，可设置下面两个 SMS 专用变量。
ALIBABA_CLOUD_SMS_ACCESS_KEY_ID=
ALIBABA_CLOUD_SMS_ACCESS_KEY_SECRET=
# 短信签名名称，例如：阿里云短信测试
ALIBABA_CLOUD_SMS_SIGN_NAME=
# 短信模板 Code，例如：SMS_15495****
ALIBABA_CLOUD_SMS_TEMPLATE_CODE=
# 模板中验证码变量名。模板为 ${code} 时保持默认 code。
ALIBABA_CLOUD_SMS_CODE_PARAM_NAME=code
# 中国大陆短信默认 Endpoint，一般无需修改。
ALIBABA_CLOUD_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# 如果模板还有其他固定变量，填写 JSON 对象，例如 {"product":"智鹿健康"}
ALIBABA_CLOUD_SMS_TEMPLATE_PARAM_EXTRA=
AI_SERVICE_PROVIDER_CODE=001191149900MA0LA3QG5T20001
AI_APP_PACKAGE_NAME=com.sstkjgf.app
